index 0000000..f9dd38e
--- /dev/null
+++ b/experiments/null_phase_predictions.py
@@ -0,0 +1,47 @@
+"""Theory-free predictions for held-out settings: each (delay, lam) line's crossing on the dev map, carried over unchanged.
+
+    python experiments/null_phase_predictions.py runs/phase/phase_<dev>.json settings.json \\
+        --contrast planned_once_minus_greedy --sign-beyond-crossing 1 > null_predictions.json
+
+settings.json is a JSON list of {"kappa", "delta", "horizon"}. For every held-out setting
+and every (delay, lam) line of the dev report, the predicted crossing is the one measured
+on dev for that line, in the format experiments/score_phase_predictions.py reads. A
+theory earns the word "predicts" only by placing crossings better than this.
+"""
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+from score_phase_predictions import crossing, measured_lines
+from sweep_phase_diagram import CONTRASTS
+
+
+def null_predictions(dev_report: dict, contrast: str, beyond: int, settings: list[dict]) -> dict:
+    lines, _ = measured_lines([dev_report], contrast)
+    rows = []
+    for (_, _, _, delay, lam), (sigmas, values) in sorted(lines.items()):
+        sigma_star, sign = crossing(sigmas, values.mean(axis=1))
+        for setting in settings:
+            rows.append({**{k: setting[k] for k in ("kappa", "delta", "horizon")}, "delay": delay, "lam": lam,
+                         "sigma_star": sigma_star, "sign_at_max_sigma": sign})  # fmt: skip
+    return {"contrast": contrast, "sign_beyond_crossing": beyond, "lines": rows, "fitted_on": dev_report.get("evaluation_episode_seeds")}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("dev_report", type=Path)
+    parser.add_argument("settings", type=Path)
+    parser.add_argument("--contrast", required=True, choices=sorted(CONTRASTS))
+    parser.add_argument("--sign-beyond-crossing", type=int, required=True, choices=(1, -1))
+    args = parser.parse_args()
+    report = json.loads(args.dev_report.read_text())
+    if report["args"]["tier"] != "dev":
+        parser.error("the null is fitted on the dev map only")
+    print(json.dumps(null_predictions(report, args.contrast, args.sign_beyond_crossing, json.loads(args.settings.read_text())), indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/plot_phase_diagram.py b/experiments/plot_phase_diagram.py
new file mode 100644
index 0000000..b237a4c
--- /dev/null
+++ b/experiments/plot_phase_diagram.py
@@ -0,0 +1,200 @@
+"""Draw one contrast of a phase-diagram report as small multiples, with an optional prediction overlay.
+
+    python experiments/plot_phase_diagram.py runs/phase/phase_<stamp>.json
+    python experiments/plot_phase_diagram.py runs/phase/phase_<stamp>.json --contrast greedy_over_rotation
+    python experiments/plot_phase_diagram.py runs/phase/phase_<stamp>.json --predictions predictions.json
+
+One panel per occupancy memory lam, delay on the x axis, one line per resistance noise
+level with its 95% interval at every point. Noise levels are ordered, so they take one
+hue from light to dark; sigma = 0 is grey, the floor the noisy lines are read against.
+A prediction file (a JSON list of {"delay", "lam", "sigma", <contrast>: value}) is drawn
+dashed with hollow markers in the same colours. Means and exact Student-t 95% intervals
+are recomputed from the per-episode values in the report, not read from its summaries.
+Writes an SVG and a CSV of every plotted value to figures/, named after the report.
+Standard library only.
+"""
+
+import argparse
+import math
+import csv
+import json
+import sys
+from pathlib import Path
+
+SURFACE, INK, INK_2, GRID = "#fcfcfb", "#0b0b0b", "#52514e", "#e5e4e0"
+FLOOR = "#8a8984"  # sigma = 0
+RAMP = ("#86b6ef", "#2a78d6", "#104281")  # validated ordinal blue steps 250 / 450 / 650, light to dark
+PANEL_W, PANEL_H, GAP_X, GAP_Y, LEFT, TOP, BOTTOM, COLUMNS = 260, 190, 40, 70, 70, 84, 48, 2
+
+
+def _incomplete_beta(x: float, a: float, b: float) -> float:
+    """Regularised incomplete beta I_x(a, b), by Lentz's continued fraction."""
+    if x <= 0.0 or x >= 1.0:
+        return 0.0 if x <= 0.0 else 1.0
+    if x > (a + 1.0) / (a + b + 2.0):
+        return 1.0 - _incomplete_beta(1.0 - x, b, a)
+    front = math.exp(math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b) + a * math.log(x) + b * math.log1p(-x)) / a
+    tiny, c, d = 1e-300, 1.0, 1.0 - (a + b) * x / (a + 1.0)
+    d = 1.0 / (d if abs(d) > tiny else tiny)
+    f = d
+    for m in range(1, 300):
+        for numerator in (m * (b - m) * x / ((a + 2 * m - 1) * (a + 2 * m)), -(a + m) * (a + b + m) * x / ((a + 2 * m) * (a + 2 * m + 1))):
+            d = 1.0 + numerator * d
+            d = 1.0 / (d if abs(d) > tiny else tiny)
+            c = 1.0 + numerator / c
+            c = c if abs(c) > tiny else tiny
+            f *= c * d
+        if abs(c * d - 1.0) < 1e-15:
+            break
+    return front * f
+
+
+def t_quantile_975(df: int) -> float:
+    """The 0.975 quantile of Student's t with df degrees of freedom, by bisection on its CDF."""
+    def upper_tail(t: float) -> float:
+        return 0.5 * _incomplete_beta(df / (df + t * t), df / 2.0, 0.5)
+
+    lo, hi = 0.0, 1000.0
+    for _ in range(200):
+        mid = (lo + hi) / 2.0
+        lo, hi = (mid, hi) if upper_tail(mid) > 0.025 else (lo, mid)
+    return (lo + hi) / 2.0
+
+
+def interval(values: list[float]) -> dict:
+    """Mean and exact 95% Student-t half-width."""
+    n = len(values)
+    mean = sum(values) / n
+    sd = math.sqrt(sum((v - mean) ** 2 for v in values) / (n - 1))
+    return {"mean": mean, "ci95": t_quantile_975(n - 1) * sd / math.sqrt(n)}
+
+
+def series_colours(sigmas: list[float]) -> dict[float, str]:
+    noisy = sorted(s for s in sigmas if s > 0)
+    if len(noisy) > len(RAMP):
+        raise ValueError(f"at most {len(RAMP)} noisy levels fit the ramp, got {noisy}")
+    steps = {1: RAMP[1:2], 2: RAMP[::2], 3: RAMP}.get(len(noisy), ())
+    return {**{s: c for s, c in zip(noisy, steps)}, **({0.0: FLOOR} if 0.0 in sigmas else {})}
+
+
+def draw(report: dict, contrast: str, predictions: list[dict] | None) -> tuple[str, list[dict]]:
+    cells = report["cells"]
+    delays = sorted({c["delay"] for c in cells})
+    lams = sorted({c["lam"] for c in cells})
+    sigmas = sorted({c["sigma"] for c in cells})
+    colour = series_colours(sigmas)
+    minuend, subtrahend = report["contrasts"][contrast]
+    raw = {(r["delay"], r["lam"], r["sigma"], r["policy"]): r["expected_failure_rate"] for r in report["results"]}
+    lookup = {
+        (c["delay"], c["lam"], c["sigma"]): interval([a - b for a, b in zip(raw[(c["delay"], c["lam"], c["sigma"], minuend)], raw[(c["delay"], c["lam"], c["sigma"], subtrahend)])])
+        for c in cells
+    }
+    predicted = {(p["delay"], p["lam"], p["sigma"]): p[contrast] for p in predictions or [] if contrast in p}
+
+    lows = [a["mean"] - a["ci95"] for a in lookup.values()] + list(predicted.values()) + [0.0]
+    highs = [a["mean"] + a["ci95"] for a in lookup.values()] + list(predicted.values()) + [0.0]
+    lo, hi = min(lows), max(highs)
+    pad = 0.06 * (hi - lo or 1.0)
+    lo, hi = lo - pad, hi + pad
+
+    def origin(panel: int) -> tuple[float, float]:
+        row, col = divmod(panel, COLUMNS)
+        return LEFT + col * (PANEL_W + GAP_X), TOP + row * (PANEL_H + GAP_Y)
+
+    def y(panel: int, v: float) -> float:
+        return origin(panel)[1] + PANEL_H * (hi - v) / (hi - lo)
+
+    def x(panel: int, i: int, s: float) -> float:
+        offset = (s - (len(sigmas) - 1) / 2) * 5  # keep the intervals of different sigmas apart
+        return origin(panel)[0] + 18 + i * (PANEL_W - 36) / max(len(delays) - 1, 1) + offset
+
+    rows_of_panels = -(-len(lams) // COLUMNS)
+    width = LEFT + COLUMNS * (PANEL_W + GAP_X) + 30
+    height = TOP + rows_of_panels * (PANEL_H + GAP_Y) - GAP_Y + BOTTOM
+    out = [
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}" '
+        f'font-family="Helvetica, Arial, sans-serif" font-size="12">',
+        f'<rect width="{width}" height="{height}" fill="{SURFACE}"/>',
+        f'<text x="{LEFT}" y="22" font-size="14" font-weight="bold" fill="{INK}">{contrast.replace("_", " ")}</text>',
+        f'<text x="{LEFT}" y="40" fill="{INK_2}">difference in expected failure rate, mean and 95% interval over '
+        f'{len(report["evaluation_episode_seeds"])} {report["args"]["tier"]}-tier episodes{"; dashed: prediction" if predicted else ""}</text>',
+    ]
+    # legend, one entry per noise level, under the subtitle
+    for k, s in enumerate(sigmas):
+        out.append(f'<circle cx="{LEFT + 4 + k * 76}" cy="56" r="4" fill="{colour[s]}"/>')
+        out.append(f'<text x="{LEFT + 12 + k * 76}" y="60" fill="{INK_2}">σ = {s:g}</text>')
+
+    rows = []
+    for panel, lam in enumerate(lams):
+        px, py = origin(panel)
+        out.append(f'<text x="{px + PANEL_W / 2}" y="{py - 8}" text-anchor="middle" fill="{INK}">λ = {lam:g}</text>')
+        for tick in _ticks(lo, hi):
+            out.append(f'<line x1="{px}" x2="{px + PANEL_W}" y1="{y(panel, tick):.1f}" y2="{y(panel, tick):.1f}" stroke="{GRID}" stroke-width="1"/>')
+            if panel % COLUMNS == 0:
+                out.append(f'<text x="{px - 6}" y="{y(panel, tick) + 4:.1f}" text-anchor="end" fill="{INK_2}">{tick:+.3f}</text>')
+        out.append(f'<line x1="{px}" x2="{px + PANEL_W}" y1="{y(panel, 0):.1f}" y2="{y(panel, 0):.1f}" stroke="{INK_2}" stroke-width="1"/>')
+        for i, d in enumerate(delays):
+            out.append(f'<text x="{x(panel, i, (len(sigmas) - 1) / 2):.1f}" y="{py + PANEL_H + 18}" text-anchor="middle" fill="{INK_2}">{d}</text>')
+        out.append(f'<text x="{px + PANEL_W / 2}" y="{py + PANEL_H + 36}" text-anchor="middle" fill="{INK_2}">delay (quarters)</text>')
+        for s_index, s in enumerate(sigmas):
+            measured = [(i, lookup[(d, lam, s)]) for i, d in enumerate(delays) if (d, lam, s) in lookup]
+            points = " ".join(f"{x(panel, i, s_index):.1f},{y(panel, a['mean']):.1f}" for i, a in measured)
+            out.append(f'<polyline points="{points}" fill="none" stroke="{colour[s]}" stroke-width="2"/>')
+            for i, a in measured:
+                cx = x(panel, i, s_index)
+                out.append(f'<line x1="{cx:.1f}" x2="{cx:.1f}" y1="{y(panel, a["mean"] - a["ci95"]):.1f}" y2="{y(panel, a["mean"] + a["ci95"]):.1f}" stroke="{colour[s]}" stroke-width="1.5"/>')
+                out.append(f'<circle cx="{cx:.1f}" cy="{y(panel, a["mean"]):.1f}" r="4" fill="{colour[s]}" stroke="{SURFACE}" stroke-width="2"/>')
+                rows.append({"delay": delays[i], "lam": lam, "sigma": s, "mean": a["mean"], "ci95": a["ci95"],
+                             "predicted": predicted.get((delays[i], lam, s), "")})  # fmt: skip
+            guessed = [(i, predicted[(d, lam, s)]) for i, d in enumerate(delays) if (d, lam, s) in predicted]
+            if guessed:
+                points = " ".join(f"{x(panel, i, s_index):.1f},{y(panel, v):.1f}" for i, v in guessed)
+                out.append(f'<polyline points="{points}" fill="none" stroke="{colour[s]}" stroke-width="2" stroke-dasharray="5 4"/>')
+                for i, v in guessed:
+                    out.append(f'<circle cx="{x(panel, i, s_index):.1f}" cy="{y(panel, v):.1f}" r="4" fill="{SURFACE}" stroke="{colour[s]}" stroke-width="2"/>')
+        if panel == len(lams) - 1:  # direct labels at the line ends of the last panel, pushed apart to stay legible
+            ends = sorted((y(panel, lookup[(delays[-1], lam, s)]["mean"]), s) for s in sigmas if (delays[-1], lam, s) in lookup)
+            placed = []
+            for end, s in ends:
+                placed.append((max(end, placed[-1][0] + 13) if placed else end, s))
+            for label_y, s in placed:
+                out.append(f'<text x="{x(panel, len(delays) - 1, len(sigmas)) + 6:.1f}" y="{label_y + 4:.1f}" fill="{INK_2}">σ {s:g}</text>')
+    out.append("</svg>")
+    return "\n".join(out), rows
+
+
+def _ticks(lo: float, hi: float, n: int = 5) -> list[float]:
+    raw = (hi - lo) / n
+    magnitude = 10 ** math.floor(math.log10(raw))
+    step = next(m * magnitude for m in (1, 2, 2.5, 5, 10) if m * magnitude >= raw)
+    first = math.ceil(lo / step) * step
+    return [first + k * step for k in range(int((hi - first) / step) + 1)]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("report", type=Path, help="a runs/phase/phase_*.json report")
+    parser.add_argument("--contrast", default="value_of_feedback")
+    parser.add_argument("--predictions", type=Path, help="JSON list of predicted cell values to overlay")
+    parser.add_argument("--out", type=Path, default=Path("figures"))
+    args = parser.parse_args()
+    report = json.loads(args.report.read_text())
+    if args.contrast not in report["contrasts"]:
+        parser.error(f"--contrast must be one of {sorted(report['contrasts'])}")
+    predictions = json.loads(args.predictions.read_text()) if args.predictions else None
+    if isinstance(predictions, dict):  # also accept {"cells": [...]}
+        predictions = predictions.get("cells", [])
+    svg, rows = draw(report, args.contrast, predictions)
+    args.out.mkdir(parents=True, exist_ok=True)
+    stem = f"{args.report.stem}_{args.contrast}"
+    (args.out / f"{stem}.svg").write_text(svg)
+    with open(args.out / f"{stem}.csv", "w", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=["delay", "lam", "sigma", "mean", "ci95", "predicted"])
+        writer.writeheader()
+        writer.writerows(rows)
+    print(f"Wrote {args.out / stem}.svg and .csv")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/predict_entropy_gap.py b/experiments/predict_entropy_gap.py
new file mode 100644
index 0000000..33771d0
--- /dev/null
+++ b/experiments/predict_entropy_gap.py
@@ -0,0 +1,174 @@
+"""Predicted failure-rate gap between class entropy and drug entropy, from the mean-field model alone.
+
+    python experiments/predict_entropy_gap.py --class-sizes 3 1 --alphas 0 0.001 0.01 0.1
+    python experiments/predict_entropy_gap.py --from-report runs/train/train_<stamp>.json
+
+With exactly interchangeable drugs and networks that tie them, a policy is uniform within
+each class, so its entropy over drugs is H(q) + sum_j q_j log n_j, with q the class
+masses. Drug-entropy SAC therefore maximises the class-entropy objective plus
+alpha * sum_j q_j log n_j: a bonus for mass on larger classes, zero in difference when
+the classes are equal. For each temperature this solves both problems on the
+mean-field model, as open-loop schedules of class masses from the nominal start,
+
+    maximise  sum_q gamma**q * (alpha * H(q_q) - reward_scale * failure_q)      class entropy (OC-SAC)
+    maximise  the same + gamma**q * alpha * sum_j q_qj log n_j                   drug entropy (SAC)
+
+and reports each optimum's undiscounted failure rate and their difference. With
+--from-report the temperatures are each agent's median alpha(s) over its evaluation
+states, averaged over seeds, so the prediction is made at the temperatures the agents
+actually reached. Approximations, each a way the prediction can miss: open loop from the
+nominal start where the agents act on the jittered state; a mixed schedule where the
+agents give one drug per quarter; one temperature where the agents' alpha depends on the
+state. Writes a JSON report to runs/predict/.
+"""
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from train_agent import ENV_KWARGS, PAIRED_DRUGS, cross_resistance, git_state
+
+MODES = ("class entropy", "drug entropy")
+
+
+def soft_optimal_schedule(model, class_sizes, alpha: float, mode: str, gamma: float, reward_scale: float,
+                          steps: int, n_random: int, seed: int) -> dict:  # fmt: skip
+    """Best open-loop schedule of class masses for one entropy mode and temperature, by Adam from several starts."""
+    from ocmdp.baselines.oracle import best_rotation
+
+    sizes = torch.tensor(class_sizes, dtype=torch.float64)
+    n_quarters, n_classes = model.config.horizon_quarters, len(class_sizes)
+    owner = torch.repeat_interleave(torch.arange(n_classes), sizes.long())  # class of each drug
+    discount = gamma ** torch.arange(n_quarters, dtype=torch.float64)
+
+    def schedule(masses: torch.Tensor) -> torch.Tensor:
+        return masses[..., owner] / sizes[owner]  # uniform within each class
+
+    def objective(masses: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        failure = model.simulate(schedule(masses))[0]
+        entropy = -(masses * masses.clamp_min(1e-300).log()).sum(-1)
+        if mode == "drug entropy":
+            entropy = entropy + (masses * sizes.log()).sum(-1)
+        return ((alpha * entropy - reward_scale * failure) * discount).sum(-1), failure
+
+    classes = [tuple(int(d) for d in torch.nonzero(owner == c).flatten()) for c in range(n_classes)]
+    rotation, _, _ = best_rotation(model, model.initial_state(), classes, n_quarters)
+    rotation_masses = torch.stack([torch.from_numpy(rotation[:, list(c)].sum(-1)) for c in classes], -1)
+    generator = torch.Generator().manual_seed(seed)
+    starts = torch.cat([
+        torch.zeros(1, n_quarters, n_classes, dtype=torch.float64),
+        rotation_masses.clamp_min(1e-6).log()[None],
+        torch.randn(n_random, n_quarters, n_classes, generator=generator, dtype=torch.float64),
+    ])  # fmt: skip
+    logits = starts.clone().requires_grad_(True)
+    opt = torch.optim.Adam([logits], lr=0.05)
+    best = (-float("inf"), None)
+    for step in range(steps + 1):
+        value, _ = objective(torch.softmax(logits, -1))
+        i = int(torch.nan_to_num(value.detach(), nan=-float("inf")).argmax())
+        if value[i].item() > best[0]:
+            best = (value[i].item(), logits.detach()[i].clone())
+        if step < steps:
+            opt.zero_grad()
+            (-value.sum()).backward()
+            opt.step()
+    masses = torch.softmax(best[1], -1)
+    with torch.no_grad():
+        _, failure = objective(masses)
+    class_entropy = -(masses * masses.clamp_min(1e-300).log()).sum(-1)
+    return {
+        "soft_return": best[0],
+        "expected_failure_rate": float(failure.mean()),
+        "mean_class_entropy": float(class_entropy.mean()),
+        "mean_mass_by_class": masses.mean(0).tolist(),
+    }
+
+
+def predict(class_sizes: tuple[int, ...], alphas: dict[str, float], gamma: float, reward_scale: float,
+            steps: int, n_random: int, seed: int) -> dict:  # fmt: skip
+    from ocmdp.envs.toy import ToyConfig
+    from ocmdp.theory.mean_field import MeanFieldModel
+
+    model = MeanFieldModel(ToyConfig(cross_resistance=cross_resistance(class_sizes), **ENV_KWARGS))
+    out = {mode: soft_optimal_schedule(model, class_sizes, alphas[mode], mode, gamma, reward_scale, steps, n_random, seed) for mode in MODES}
+    out["alphas"] = dict(alphas)
+    out["class entropy minus drug entropy"] = out["class entropy"]["expected_failure_rate"] - out["drug entropy"]["expected_failure_rate"]
+    return out
+
+
+def temperatures_from_report(path: Path) -> tuple[tuple[int, ...], dict[str, float], float, float]:
+    """Class sizes, each variant's median evaluation temperature averaged over seeds, gamma and reward scale."""
+    report = json.loads(path.read_text())
+    variant_mode = {"oc-sac": "class entropy", "sac": "drug entropy"}
+    alphas = {}
+    for variant, mode in variant_mode.items():
+        medians = [r["alpha_at_evaluation"]["q50"] for r in report["runs"] if r["variant"] == variant and "alpha_at_evaluation" in r]
+        if not medians:
+            raise ValueError(f"{path} logs no evaluation temperatures for {variant}")
+        alphas[mode] = float(np.mean(medians))
+    config = report["sac_config"]["oc-sac"]
+    return tuple(report["class_structure"]["class_sizes"]), alphas, config["gamma"], config["reward_scale"]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--class-sizes", type=int, nargs="+", default=list(PAIRED_DRUGS), metavar="N")
+    parser.add_argument("--alphas", type=float, nargs="+", default=[0.0, 0.001, 0.01, 0.1], help="temperatures, applied to both modes")
+    parser.add_argument("--from-report", type=Path, help="a runs/train report: predict at the temperatures its agents reached")
+    parser.add_argument("--gamma", type=float, default=0.97)
+    parser.add_argument("--reward-scale", type=float, default=10.0)
+    parser.add_argument("--steps", type=int, default=400, help="Adam steps per schedule")
+    parser.add_argument("--random-starts", type=int, default=8)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--out", type=Path, default=Path("runs/predict"))
+    args = parser.parse_args()
+    if len(args.class_sizes) < 2 or min(args.class_sizes) < 1:
+        parser.error("--class-sizes needs at least two classes of at least one drug each")
+    if min(args.alphas) < 0 or not 0 < args.gamma <= 1 or args.steps < 1 or args.random_starts < 0:
+        parser.error("need alphas >= 0, gamma in (0, 1], steps >= 1 and random starts >= 0")
+    if args.out.exists() and not args.out.is_dir():
+        parser.error(f"--out {args.out} exists and is not a directory")
+    torch.set_num_threads(1)
+    git = git_state()
+
+    if args.from_report:
+        try:
+            sizes, alphas, gamma, reward_scale = temperatures_from_report(args.from_report)
+        except (OSError, ValueError, KeyError) as exc:
+            parser.error(str(exc))
+        predictions = [predict(sizes, alphas, gamma, reward_scale, args.steps, args.random_starts, args.seed)]
+    else:
+        sizes, gamma, reward_scale = tuple(args.class_sizes), args.gamma, args.reward_scale
+        predictions = [predict(sizes, {m: a for m in MODES}, gamma, reward_scale, args.steps, args.random_starts, args.seed) for a in args.alphas]
+
+    args.out.mkdir(parents=True, exist_ok=True)
+    report = {
+        "args": {k: str(v) if isinstance(v, Path) else v for k, v in vars(args).items()},
+        "git": git,
+        "class_sizes": list(sizes),
+        "gamma": gamma,
+        "reward_scale": reward_scale,
+        "predictions": predictions,
+    }
+    path = args.out / f"predict_{time.strftime('%Y%m%d_%H%M%S')}_{os.getpid()}.json"
+    path.write_text(json.dumps(report, indent=2))
+    print(f"Class sizes {list(sizes)}: predicted expected failure rate of each soft-optimal schedule")
+    for p in predictions:
+        a = p["alphas"]
+        print(
+            f"  alpha class {a['class entropy']:.2e} / drug {a['drug entropy']:.2e}:"
+            f"  class entropy {p['class entropy']['expected_failure_rate']:.4f}  drug entropy {p['drug entropy']['expected_failure_rate']:.4f}"
+            f"  difference {p['class entropy minus drug entropy']:+.5f}"
+        )
+    print(f"\nReport: {path}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
