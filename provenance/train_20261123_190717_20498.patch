diff --git a/experiments/modal_backend.py b/experiments/modal_backend.py
new file mode 100644
index 0000000..f91edbd
--- /dev/null
+++ b/experiments/modal_backend.py
@@ -0,0 +1,60 @@
+"""Run the jobs of an experiment script on Modal instead of in local processes.
+
+    python experiments/train_agent.py --tier dev --backend modal
+    python experiments/sweep_phase_diagram.py --tier dev --backend modal
+
+A job is a call `module.function(job)` into one of SCRIPTS, and each runs in its own
+one-CPU container. The image pins numpy, torch (CPU build) and gymnasium to the versions
+installed locally, and the ocmdp package and the scripts are added from the working
+tree when the app starts, so a remote run executes the code the report's git state
+describes. Containers are x86-64 Linux: floating-point results need not match a local
+arm64 run bit for bit, which is why each report records its backend. Every job of one
+report runs on the same backend.
+"""
+
+import importlib
+import platform
+from importlib.metadata import version
+from pathlib import Path
+
+import modal
+
+HERE = Path(__file__).resolve().parent
+SCRIPTS = ("train_agent", "sweep_phase_diagram")
+PYTHON = ".".join(platform.python_version_tuple()[:2])
+PINNED = {name: version(name) for name in ("numpy", "torch", "gymnasium")}
+JOB_TIMEOUT = 4 * 3600  # seconds; the longest local job, a 12 000-quarter training run, takes under 10 minutes
+
+# Containers land on different x86 CPUs, and torch and MKL pick SIMD kernels per CPU, which changes
+# rounding and, in a chaotic training run, the outcome. Pinning both to their portable paths makes
+# every container do the same arithmetic.
+ARITHMETIC = {"ATEN_CPU_CAPABILITY": "default", "MKL_CBWR": "COMPATIBLE"}
+
+image = (
+    modal.Image.debian_slim(python_version=PYTHON)
+    .uv_pip_install(f"numpy=={PINNED['numpy']}", f"gymnasium=={PINNED['gymnasium']}")
+    .uv_pip_install(f"torch=={PINNED['torch']}", index_url="https://download.pytorch.org/whl/cpu")
+    .env(ARITHMETIC)
+    .add_local_python_source("ocmdp")
+)
+for script in SCRIPTS:
+    image = image.add_local_file(HERE / f"{script}.py", f"/root/{script}.py")
+app = modal.App("ocmdp-experiments", image=image)
+
+
+@app.function(cpu=1.0, timeout=JOB_TIMEOUT)
+def run_job(module: str, function: str, job: tuple):
+    return getattr(importlib.import_module(module), function)(job)
+
+
+def run_jobs(calls: list[tuple[str, str, tuple]]) -> list:
+    """(module, function, job) triples -> their results, in the same order."""
+    unknown = {module for module, _, _ in calls} - set(SCRIPTS)
+    if unknown:
+        raise ValueError(f"jobs must call into {SCRIPTS}, got {sorted(unknown)}")
+    with modal.enable_output(), app.run():
+        return list(run_job.starmap(calls))
+
+
+def description() -> dict:
+    return {"name": "modal", "python": PYTHON, "packages": PINNED, "cpu_per_job": 1.0, "environment": ARITHMETIC}
diff --git a/experiments/plot_phase_diagram.py b/experiments/plot_phase_diagram.py
new file mode 100644
index 0000000..8bfec00
--- /dev/null
+++ b/experiments/plot_phase_diagram.py
@@ -0,0 +1,151 @@
+"""Draw one contrast of a phase-diagram report as small multiples, with an optional prediction overlay.
+
+    python experiments/plot_phase_diagram.py runs/phase/phase_<stamp>.json
+    python experiments/plot_phase_diagram.py runs/phase/phase_<stamp>.json --contrast greedy_over_rotation
+    python experiments/plot_phase_diagram.py runs/phase/phase_<stamp>.json --predictions predictions.json
+
+One panel per occupancy memory lam, delay on the x axis, one line per resistance noise
+level with its 95% interval at every point. Noise levels are ordered, so they take one
+hue from light to dark; sigma = 0 is grey, the floor the noisy lines are read against.
+A prediction file (a JSON list of {"delay", "lam", "sigma", <contrast>: value}) is drawn
+dashed with hollow markers in the same colours. Writes an SVG and a CSV of every plotted
+value to figures/, named after the report. Standard library only.
+"""
+
+import argparse
+import math
+import csv
+import json
+import sys
+from pathlib import Path
+
+SURFACE, INK, INK_2, GRID = "#fcfcfb", "#0b0b0b", "#52514e", "#e5e4e0"
+FLOOR = "#8a8984"  # sigma = 0
+RAMP = ("#86b6ef", "#2a78d6", "#104281")  # validated ordinal blue steps 250 / 450 / 650, light to dark
+PANEL_W, PANEL_H, GAP_X, GAP_Y, LEFT, TOP, BOTTOM, COLUMNS = 260, 190, 40, 70, 70, 84, 48, 2
+
+
+def series_colours(sigmas: list[float]) -> dict[float, str]:
+    noisy = sorted(s for s in sigmas if s > 0)
+    if len(noisy) > len(RAMP):
+        raise ValueError(f"at most {len(RAMP)} noisy levels fit the ramp, got {noisy}")
+    steps = {1: RAMP[1:2], 2: RAMP[::2], 3: RAMP}.get(len(noisy), ())
+    return {**{s: c for s, c in zip(noisy, steps)}, **({0.0: FLOOR} if 0.0 in sigmas else {})}
+
+
+def draw(report: dict, contrast: str, predictions: list[dict] | None) -> tuple[str, list[dict]]:
+    cells = report["cells"]
+    delays = sorted({c["delay"] for c in cells})
+    lams = sorted({c["lam"] for c in cells})
+    sigmas = sorted({c["sigma"] for c in cells})
+    colour = series_colours(sigmas)
+    lookup = {(c["delay"], c["lam"], c["sigma"]): c[contrast] for c in cells}
+    predicted = {(p["delay"], p["lam"], p["sigma"]): p[contrast] for p in predictions or [] if contrast in p}
+
+    lows = [a["mean"] - a["ci95"] for a in lookup.values()] + list(predicted.values()) + [0.0]
+    highs = [a["mean"] + a["ci95"] for a in lookup.values()] + list(predicted.values()) + [0.0]
+    lo, hi = min(lows), max(highs)
+    pad = 0.06 * (hi - lo or 1.0)
+    lo, hi = lo - pad, hi + pad
+
+    def origin(panel: int) -> tuple[float, float]:
+        row, col = divmod(panel, COLUMNS)
+        return LEFT + col * (PANEL_W + GAP_X), TOP + row * (PANEL_H + GAP_Y)
+
+    def y(panel: int, v: float) -> float:
+        return origin(panel)[1] + PANEL_H * (hi - v) / (hi - lo)
+
+    def x(panel: int, i: int, s: float) -> float:
+        offset = (s - (len(sigmas) - 1) / 2) * 5  # keep the intervals of different sigmas apart
+        return origin(panel)[0] + 18 + i * (PANEL_W - 36) / max(len(delays) - 1, 1) + offset
+
+    rows_of_panels = -(-len(lams) // COLUMNS)
+    width = LEFT + COLUMNS * (PANEL_W + GAP_X) + 30
+    height = TOP + rows_of_panels * (PANEL_H + GAP_Y) - GAP_Y + BOTTOM
+    out = [
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}" '
+        f'font-family="Helvetica, Arial, sans-serif" font-size="12">',
+        f'<rect width="{width}" height="{height}" fill="{SURFACE}"/>',
+        f'<text x="{LEFT}" y="22" font-size="14" font-weight="bold" fill="{INK}">{contrast.replace("_", " ")}</text>',
+        f'<text x="{LEFT}" y="40" fill="{INK_2}">difference in expected failure rate, mean and 95% interval over '
+        f'{len(report["evaluation_episode_seeds"])} {report["args"]["tier"]}-tier episodes; dashed: prediction</text>',
+    ]
+    # legend, one entry per noise level, under the subtitle
+    for k, s in enumerate(sigmas):
+        out.append(f'<circle cx="{LEFT + 4 + k * 76}" cy="56" r="4" fill="{colour[s]}"/>')
+        out.append(f'<text x="{LEFT + 12 + k * 76}" y="60" fill="{INK_2}">σ = {s:g}</text>')
+
+    rows = []
+    for panel, lam in enumerate(lams):
+        px, py = origin(panel)
+        out.append(f'<text x="{px + PANEL_W / 2}" y="{py - 8}" text-anchor="middle" fill="{INK}">λ = {lam:g}</text>')
+        for tick in _ticks(lo, hi):
+            out.append(f'<line x1="{px}" x2="{px + PANEL_W}" y1="{y(panel, tick):.1f}" y2="{y(panel, tick):.1f}" stroke="{GRID}" stroke-width="1"/>')
+            if panel % COLUMNS == 0:
+                out.append(f'<text x="{px - 6}" y="{y(panel, tick) + 4:.1f}" text-anchor="end" fill="{INK_2}">{tick:+.3f}</text>')
+        out.append(f'<line x1="{px}" x2="{px + PANEL_W}" y1="{y(panel, 0):.1f}" y2="{y(panel, 0):.1f}" stroke="{INK_2}" stroke-width="1"/>')
+        for i, d in enumerate(delays):
+            out.append(f'<text x="{x(panel, i, (len(sigmas) - 1) / 2):.1f}" y="{py + PANEL_H + 18}" text-anchor="middle" fill="{INK_2}">{d}</text>')
+        out.append(f'<text x="{px + PANEL_W / 2}" y="{py + PANEL_H + 36}" text-anchor="middle" fill="{INK_2}">delay (quarters)</text>')
+        for s_index, s in enumerate(sigmas):
+            measured = [(i, lookup[(d, lam, s)]) for i, d in enumerate(delays) if (d, lam, s) in lookup]
+            points = " ".join(f"{x(panel, i, s_index):.1f},{y(panel, a['mean']):.1f}" for i, a in measured)
+            out.append(f'<polyline points="{points}" fill="none" stroke="{colour[s]}" stroke-width="2"/>')
+            for i, a in measured:
+                cx = x(panel, i, s_index)
+                out.append(f'<line x1="{cx:.1f}" x2="{cx:.1f}" y1="{y(panel, a["mean"] - a["ci95"]):.1f}" y2="{y(panel, a["mean"] + a["ci95"]):.1f}" stroke="{colour[s]}" stroke-width="1.5"/>')
+                out.append(f'<circle cx="{cx:.1f}" cy="{y(panel, a["mean"]):.1f}" r="4" fill="{colour[s]}" stroke="{SURFACE}" stroke-width="2"/>')
+                rows.append({"delay": delays[i], "lam": lam, "sigma": s, "mean": a["mean"], "ci95": a["ci95"],
+                             "predicted": predicted.get((delays[i], lam, s), "")})  # fmt: skip
+            guessed = [(i, predicted[(d, lam, s)]) for i, d in enumerate(delays) if (d, lam, s) in predicted]
+            if guessed:
+                points = " ".join(f"{x(panel, i, s_index):.1f},{y(panel, v):.1f}" for i, v in guessed)
+                out.append(f'<polyline points="{points}" fill="none" stroke="{colour[s]}" stroke-width="2" stroke-dasharray="5 4"/>')
+                for i, v in guessed:
+                    out.append(f'<circle cx="{x(panel, i, s_index):.1f}" cy="{y(panel, v):.1f}" r="4" fill="{SURFACE}" stroke="{colour[s]}" stroke-width="2"/>')
+        if panel == len(lams) - 1:  # direct labels at the line ends of the last panel, pushed apart to stay legible
+            ends = sorted((y(panel, lookup[(delays[-1], lam, s)]["mean"]), s) for s in sigmas if (delays[-1], lam, s) in lookup)
+            placed = []
+            for end, s in ends:
+                placed.append((max(end, placed[-1][0] + 13) if placed else end, s))
+            for label_y, s in placed:
+                out.append(f'<text x="{x(panel, len(delays) - 1, len(sigmas)) + 6:.1f}" y="{label_y + 4:.1f}" fill="{INK_2}">σ {s:g}</text>')
+    out.append("</svg>")
+    return "\n".join(out), rows
+
+
+def _ticks(lo: float, hi: float, n: int = 5) -> list[float]:
+    raw = (hi - lo) / n
+    magnitude = 10 ** math.floor(math.log10(raw))
+    step = next(m * magnitude for m in (1, 2, 2.5, 5, 10) if m * magnitude >= raw)
+    first = math.ceil(lo / step) * step
+    return [first + k * step for k in range(int((hi - first) / step) + 1)]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("report", type=Path, help="a runs/phase/phase_*.json report")
+    parser.add_argument("--contrast", default="value_of_feedback")
+    parser.add_argument("--predictions", type=Path, help="JSON list of predicted cell values to overlay")
+    parser.add_argument("--out", type=Path, default=Path("figures"))
+    args = parser.parse_args()
+    report = json.loads(args.report.read_text())
+    if args.contrast not in report["contrasts"]:
+        parser.error(f"--contrast must be one of {sorted(report['contrasts'])}")
+    predictions = json.loads(args.predictions.read_text()) if args.predictions else None
+    if isinstance(predictions, dict):  # also accept {"cells": [...]}
+        predictions = predictions.get("cells", [])
+    svg, rows = draw(report, args.contrast, predictions)
+    args.out.mkdir(parents=True, exist_ok=True)
+    stem = f"{args.report.stem}_{args.contrast}"
+    (args.out / f"{stem}.svg").write_text(svg)
+    with open(args.out / f"{stem}.csv", "w", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=["delay", "lam", "sigma", "mean", "ci95", "predicted"])
+        writer.writeheader()
+        writer.writerows(rows)
+    print(f"Wrote {args.out / stem}.svg and .csv")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/sweep_phase_diagram.py b/experiments/sweep_phase_diagram.py
new file mode 100644
index 0000000..7b17d7e
--- /dev/null
+++ b/experiments/sweep_phase_diagram.py
@@ -0,0 +1,192 @@
+"""Phase diagram of the coupling: where acting on the observed state beats committing to a schedule.
+
+    python experiments/sweep_phase_diagram.py --tier dev
+    python experiments/sweep_phase_diagram.py --tier dev --delays 0 1 4 --lams 0 0.8 --sigmas 0 0.2 --episodes 10
+    python experiments/sweep_phase_diagram.py --tier dev --backend modal
+
+Each cell of the grid is one environment: delay d (quarters before prescribing becomes
+selection pressure), occupancy memory lam (beta = 1 - lam is the weight of the newest
+quarter) and resistance noise sigma, on the instance given by --class-sizes. Every
+policy in a cell is rolled out on the same evaluation episodes of the tier, with the
+starting state jittered as in training, so differences within a cell are paired.
+
+Policies, none of them learned:
+  uniform            uniform mixing over drugs
+  greedy             the drug with the lowest current failure probability (closed loop, myopic)
+  rotation           the best class rotation, chosen on the mean-field model from the nominal start
+                     and never revised (a blind fixed schedule)
+  planned-once       the noise-free planner: plans the whole episode once, from the episode's true
+                     starting state, on the noise-free model, and commits to it
+  replanned-every-4  the same planner, replanning from the state reached every 4 quarters
+  replanned-every-1  the same planner, replanning every quarter
+
+Reported per cell, paired over episodes with 95% t-intervals:
+  value_of_feedback      planned-once minus replanned-every-1: what revising the plan from the
+                         observed state is worth over committing at the start, with the same planner.
+                         Without noise the model is exact and there is nothing new to observe, so any
+                         gain there is extra optimisation by the replanner, not feedback; that column
+                         is the floor the noisy columns are read against.
+  feedback_over_rotation rotation minus replanned-every-1
+  greedy_over_rotation   rotation minus greedy: a closed loop with no model against a blind schedule
+
+Planning only; nothing is trained. Writes a JSON report to runs/phase/ with every
+per-episode value, so every summary number can be recomputed.
+"""
+
+import argparse
+import itertools
+import json
+import os
+import platform
+import sys
+import time
+from concurrent.futures import ProcessPoolExecutor
+from dataclasses import asdict
+from pathlib import Path
+
+import numpy as np
+
+from train_agent import ENV_KWARGS, PAIRED_DRUGS, ROOT, TIERS, cross_resistance, git_state, load_tiers
+
+POLICIES = ("uniform", "greedy", "rotation", "planned-once", "replanned-every-4", "replanned-every-1")
+CONTRASTS = {  # name: (minuend, subtrahend); positive means the subtrahend fails less
+    "value_of_feedback": ("planned-once", "replanned-every-1"),
+    "feedback_over_rotation": ("rotation", "replanned-every-1"),
+    "greedy_over_rotation": ("rotation", "greedy"),
+}
+
+
+def cell_config(delay: int, lam: float, sigma: float, class_sizes: tuple[int, ...], horizon: int):
+    from ocmdp.envs.toy import ToyConfig
+
+    return ToyConfig(
+        cross_resistance=cross_resistance(class_sizes), delay=delay, lam=lam, resistance_noise=sigma, horizon_quarters=horizon, **ENV_KWARGS
+    )
+
+
+def make_policy(name: str, env):
+    from ocmdp.baselines.heuristics import MyopicGreedy, uniform_mixing
+    from ocmdp.baselines.oracle import FullInformationOracle, tuned_cycling
+
+    horizon = env.unwrapped.config.horizon_quarters
+    if name == "uniform":
+        return uniform_mixing(env.action_space.n)
+    if name == "greedy":
+        return MyopicGreedy()
+    if name == "rotation":
+        return tuned_cycling(env.unwrapped.config)
+    if name == "planned-once":
+        return FullInformationOracle(env, replan_every=horizon, name=name)
+    every = int(name.rsplit("-", 1)[1])
+    return FullInformationOracle(env, replan_every=every, name=name)
+
+
+def evaluate_cell_policy(job: tuple[int, float, float, tuple[int, ...], int, str, int, int]) -> dict:
+    """Roll one policy out on one cell's evaluation episodes."""
+    delay, lam, sigma, class_sizes, horizon, policy_name, episodes, first_episode = job
+    import torch
+
+    from ocmdp.envs.toy import ToyOCMDPEnv
+    from ocmdp.eval.metrics import expected_failure_rate
+    from ocmdp.eval.rollout import rollout
+    from ocmdp.eval.seeds import eval_seed
+
+    torch.set_num_threads(1)
+    env = ToyOCMDPEnv(cell_config(delay, lam, sigma, class_sizes, horizon))
+    policy = make_policy(policy_name, env)
+    start = time.time()
+    rates = [expected_failure_rate(rollout(env, policy, eval_seed(first_episode + e))) for e in range(episodes)]
+    return {"delay": delay, "lam": lam, "sigma": sigma, "policy": policy_name, "expected_failure_rate": rates, "seconds": time.time() - start}
+
+
+def summarise_cell(rates: dict[str, list[float]]) -> dict:
+    from ocmdp.eval.vv import aggregate
+
+    out = {"expected_failure_rate": {name: aggregate(values) for name, values in rates.items()}}
+    for contrast, (a, b) in CONTRASTS.items():
+        out[contrast] = aggregate(np.asarray(rates[a]) - np.asarray(rates[b]))
+    return out
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--tier", choices=TIERS, required=True, help="seed tier: fixes the evaluation episodes")
+    parser.add_argument("--prereg", type=Path, help="preregistration this sweep belongs to; required for --tier test")
+    parser.add_argument("--delays", type=int, nargs="+", default=[0, 1, 2, 4, 8])
+    parser.add_argument("--lams", type=float, nargs="+", default=[0.0, 0.5, 0.8, 0.95])
+    parser.add_argument("--sigmas", type=float, nargs="+", default=[0.0, 0.1, 0.2, 0.4])
+    parser.add_argument("--class-sizes", type=int, nargs="+", default=list(PAIRED_DRUGS), metavar="N", help="drugs per mechanism class")
+    parser.add_argument("--horizon", type=int, default=40, help="quarters per episode")
+    parser.add_argument("--episodes", type=int, default=20, help="evaluation episodes per cell, shared by every policy")
+    parser.add_argument("--seeds-file", type=Path, default=ROOT / "seeds.yaml", help="tier definitions")
+    parser.add_argument("--workers", type=int, default=os.cpu_count(), help="local processes (--backend local)")
+    parser.add_argument("--backend", choices=("local", "modal"), default="local", help="where the jobs run; see experiments/modal_backend.py")
+    parser.add_argument("--out", type=Path, default=Path("runs/phase"))
+    args = parser.parse_args()
+    try:
+        tier = load_tiers(args.seeds_file)[args.tier]
+    except (OSError, ValueError) as exc:
+        parser.error(str(exc))
+    if min(args.delays) < 0 or len(set(args.delays)) != len(args.delays):
+        parser.error("--delays must be distinct non-negative integers")
+    if any(not 0.0 <= lam < 1.0 for lam in args.lams) or len(set(args.lams)) != len(args.lams):
+        parser.error("--lams must be distinct values in [0, 1)")
+    if any(not 0.0 <= s < np.inf for s in args.sigmas) or len(set(args.sigmas)) != len(args.sigmas):
+        parser.error("--sigmas must be distinct, finite and non-negative")
+    if len(args.class_sizes) < 2 or min(args.class_sizes) < 1:
+        parser.error("--class-sizes needs at least two classes of at least one drug each")
+    if args.horizon < 1:
+        parser.error("--horizon must be positive")
+    if not 2 <= args.episodes <= len(tier):
+        parser.error(f"--episodes must lie in [2, {len(tier)}]: an interval needs two, and episodes are drawn from the {args.tier} tier")
+    if args.tier == "test" and (args.prereg is None or not args.prereg.is_file()):
+        parser.error("--tier test needs --prereg pointing at an existing preregistration file")
+    if args.out.exists() and not args.out.is_dir():
+        parser.error(f"--out {args.out} exists and is not a directory")
+    args.out.mkdir(parents=True, exist_ok=True)
+    git = git_state()  # read at launch: the tree may change while the sweep is in progress
+
+    sizes = tuple(args.class_sizes)
+    cells = list(itertools.product(args.delays, args.lams, args.sigmas))
+    jobs = [(d, lam, s, sizes, args.horizon, p, args.episodes, tier.start) for d, lam, s in cells for p in POLICIES]
+    if args.backend == "modal":
+        import modal_backend
+
+        backend = modal_backend.description()
+        results = modal_backend.run_jobs([("sweep_phase_diagram", "evaluate_cell_policy", job) for job in jobs])
+    else:
+        backend = {"name": "local", "platform": platform.platform(), "workers": args.workers}
+        with ProcessPoolExecutor(args.workers) as pool:
+            results = list(pool.map(evaluate_cell_policy, jobs))
+
+    from ocmdp.eval.seeds import eval_seed
+
+    by_cell = {cell: {} for cell in cells}
+    for r in results:
+        by_cell[(r["delay"], r["lam"], r["sigma"])][r["policy"]] = r["expected_failure_rate"]
+    base = cell_config(0, 0.0, 0.0, sizes, args.horizon)
+    report = {
+        "args": {k: str(v) if isinstance(v, Path) else v for k, v in vars(args).items()},
+        "git": git,
+        "backend": backend,
+        "evaluation_episode_seeds": [eval_seed(tier.start + e) for e in range(args.episodes)],
+        "instance": {k: v for k, v in asdict(base).items() if k not in ("delay", "lam", "resistance_noise")},
+        "policies": list(POLICIES),
+        "contrasts": {name: list(pair) for name, pair in CONTRASTS.items()},
+        "results": results,
+        "cells": [{"delay": d, "lam": lam, "sigma": s, **summarise_cell(by_cell[(d, lam, s)])} for d, lam, s in cells],
+    }
+    path = args.out / f"phase_{time.strftime('%Y%m%d_%H%M%S')}_{os.getpid()}.json"
+    path.write_text(json.dumps(report, indent=2))
+
+    print(f"Class sizes {list(sizes)}, horizon {args.horizon}: {len(cells)} cells, {args.episodes} {args.tier}-tier episodes each")
+    print(f"  {'delay':>5} {'lam':>5} {'sigma':>5}   " + "   ".join(f"{name} (95% interval)" for name in CONTRASTS))
+    for cell in report["cells"]:
