+    assert not protocol.step2(reports)[1]["failed"]
+    for git in ({"commit": "d" * 40, "dirty": False, "code_diff_sha256": None},  # not a commit of this repository
+                {"commit": HEAD, "dirty": True, "code_diff_sha256": "e" * 64}):  # uncommitted code: content unknown
+        reports[1]["git"] = git
+        lines, result = protocol.step2(reports)
+        assert result["failed"] and any(line.startswith("code:") for line in lines)
+    # two commits whose training code differs; a commit that only adds reports keeps the same content
+    reports[1]["git"] = {"commit": HEAD, "dirty": False, "code_diff_sha256": None}
+    monkeypatch.setattr(protocol, "code_state", lambda report: (report["_path"],))
+    reports[1]["_path"] = "other.json"
+    assert protocol.step2(reports)[1]["failed"]
+
