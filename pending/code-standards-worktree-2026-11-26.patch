+def test_step2_floor_check_fails_when_a_run_reaches_below_the_computed_floor():
+    # a floor computed too high is the bug the check exists for: entropy below it cannot be reached
+    protocol = _protocol()
+    report = _step2_report([0.1] * 4, 0.1, 0.0, fixed=0.1)
+    assert not protocol.step2([report])[1]["failed"]
+    for run in report["runs"]:
+        run["entropy_range"] = {**run["entropy_range"], "floor": 0.06}  # above the 0.05 both runs reached
+    lines, result = protocol.step2([report])
+    assert result["failed"] and any("floor" in line and "below" in line and "FAIL" in line for line in lines)
+    # inside the rounding band below the floor still passes
+    for run in report["runs"]:
+        rng = run["entropy_range"]
+        run["entropy_range"] = {**rng, "floor": 0.05 + 0.5 * protocol.FLOOR_TOLERANCE * (rng["maximum"] - 0.05)}
+    assert not protocol.step2([report])[1]["failed"]
+
+
+def test_step2_needs_every_report_to_have_run_one_version_of_the_training_code(monkeypatch):
+    protocol = _protocol()
