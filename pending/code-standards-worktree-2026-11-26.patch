+"""The OC-SAC against SAC summary: every run counted, defined gain shares, per-agent temperatures, and the
+instances where the two entropy objectives differ only by a constant."""
+
+import argparse
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@pytest.fixture
+def script():
+    sys.path.insert(0, str(ROOT / "experiments"))
+    try:
+        return __import__("train_agent")
+    finally:
+        sys.path.remove(str(ROOT / "experiments"))
+
+
+def _baselines(uniform=0.40, oracle=0.30, replanner=0.30, episodes=4):
+    def one(rate):
+        return {"expected_failure_rate": [rate] * episodes, "discounted_failure_rate": [rate] * episodes}
+
+    return {"uniform": one(uniform), "oracle": one(oracle), "oracle[replans every quarter]": one(replanner)}
+
+
+def _run(variant, seed, rate, sigma=0.0, episodes=4):
+    return {"variant": variant, "sigma": sigma, "seed": seed, "expected_failure_rate": [rate] * episodes,
+            "discounted_failure_rate": [rate] * episodes, "argmax": {"expected_failure_rate": [rate] * episodes},
+            "H_action": 1.0, "H_pushforward": 0.5, "policy_entropy": {"action": 1.0, "within_class": 0.5},
+            "critic": {}, "gap_attribution": {}, "alpha_path": [], "alpha_at_evaluation": 0.0}  # fmt: skip
+
+
+def _diverged(variant, seed, sigma=0.0):
+    return {"variant": variant, "sigma": sigma, "seed": seed, "diverged": "nan", "diverged_at_decision": 100}
+
+
+def test_a_diverged_run_counts_in_its_agents_statistics_and_in_the_paired_comparison(script):
+    runs = [_diverged("oc-sac", 0), _run("oc-sac", 1, 0.33), _run("oc-sac", 2, 0.34),
+            _run("sac", 0, 0.32), _run("sac", 1, 0.33), _run("sac", 2, 0.45)]  # fmt: skip
+    summary = script.summarise(runs, _baselines(), 0.0)
+    # paired: the worst completed run of either agent, sac's 0.45, which fails more than uniform (0.40)
+    paired = summary["paired comparison"]
+    assert paired["seeds"] == [0, 1, 2] and paired["diverged_seeds_imputed"] == {"oc-sac": [0], "sac": []}
+    assert summary["oc-sac minus sac (paired by seed)"]["mean"] == pytest.approx(((0.45 - 0.32) + 0.0 + (0.34 - 0.45)) / 3)
+    # own statistics: max(uniform, oc-sac's own worst 0.34) = 0.40, whatever sac's runs did
+    oc = summary["oc-sac"]
+    assert oc["expected_failure_rate"]["mean"] == pytest.approx((0.40 + 0.33 + 0.34) / 3)
+    assert oc["share_of_replanner_gain"]["mean"] == pytest.approx(sum((0.40 - a) / 0.10 for a in (0.40, 0.33, 0.34)) / 3)
+    assert (oc["runs"], oc["diverged"], oc["runs_learned"]) == (3, 1, 2)
+    runs[5] = _run("sac", 2, 0.30)
+    assert script.summarise(runs, _baselines(), 0.0)["oc-sac"]["expected_failure_rate"]["mean"] == pytest.approx(oc["expected_failure_rate"]["mean"])
+    own_worse = [_diverged("oc-sac", 0), _run("oc-sac", 1, 0.33), _run("oc-sac", 2, 0.47)] + runs[3:]
+    assert script.summarise(own_worse, _baselines(), 0.0)["oc-sac"]["expected_failure_rate"]["mean"] == pytest.approx((0.47 + 0.33 + 0.47) / 3)
+    assert oc["argmax_expected_failure_rate"]["mean"] == pytest.approx((0.33 + 0.34) / 2)  # completed runs only
+
+
+def test_a_seed_where_both_agents_diverged_gives_a_paired_difference_of_zero(script):
+    runs = [_diverged("oc-sac", 0), _diverged("sac", 0), _run("oc-sac", 1, 0.33), _run("sac", 1, 0.35)]
+    diffs = script.summarise(runs, _baselines(), 0.0)["oc-sac minus sac (paired by seed)"]
+    assert diffs["mean"] == pytest.approx((0.0 + (0.33 - 0.35)) / 2)
+
+
+def test_a_variant_with_every_run_diverged_is_not_summarised(script):
+    # no completed run to describe: the launch reports the noise level as not summarised and exits 1, a stop
+    runs = [_diverged("oc-sac", s) for s in range(2)] + [_run("sac", s, 0.33) for s in range(2)]
+    with pytest.raises(ValueError, match="every oc-sac run diverged"):
+        script.summarise(runs, _baselines(), 0.0)
+
+
+def test_gain_shares_need_a_replanner_that_fails_less_than_uniform(script):
+    runs = [_run(v, 0, 0.35) for v in ("oc-sac", "sac")]
+    with pytest.raises(ValueError, match="does not fail less than uniform"):
+        script.summarise(runs, _baselines(replanner=0.41), 0.0)
+
+
+def test_the_oracle_must_beat_uniform_only_where_it_is_the_bound(script):
+    runs = [_run(v, 0, 0.35) for v in ("oc-sac", "sac")]
+    with pytest.raises(ValueError, match="bounds nothing"):
+        script.summarise(runs, _baselines(oracle=0.41), 0.0)
+    noisy = [_run(v, 0, 0.35, sigma=0.2) for v in ("oc-sac", "sac")]
+    summary = script.summarise(noisy, _baselines(oracle=0.41), 0.2)  # under noise the oracle is only the noise-free planner
+    assert summary["oc-sac"]["share_of_noise_free_planner_gain"] is None
+    assert summary["oc-sac"]["share_of_replanner_gain"]["mean"] == pytest.approx((0.40 - 0.35) / 0.10)
+
+
+def test_each_agent_can_carry_its_own_temperature(script):
+    parser = argparse.ArgumentParser()
+    shared = script._parse_overrides(parser, ["temperature=fixed", "hidden_dim=16"])
+    out = script.variant_overrides(parser, shared, {"oc-sac": ["alpha=0.3"], "sac": ["alpha=0.03"]})
+    assert out == {"oc-sac": {"temperature": "fixed", "hidden_dim": 16, "alpha": 0.3}, "sac": {"temperature": "fixed", "hidden_dim": 16, "alpha": 0.03}}
+    assert script.variant_overrides(parser, shared, {}) == {"oc-sac": shared, "sac": shared}
+
+
+@pytest.mark.parametrize("pair, message", [("hidden_dim=32", "only temperature settings"),
+                                           ("alpha_init=0.5", "only temperature settings"),  # it also sets alpha_lr
+                                           ("target_fraction=2.0", "--set-sac: ")])  # fmt: skip
+def test_only_the_candidate_temperature_settings_may_differ_between_the_agents(script, capsys, pair, message):
+    with pytest.raises(SystemExit):
+        script.variant_overrides(argparse.ArgumentParser(), {}, {"sac": [pair]})
+    assert message in capsys.readouterr().err
+
+
+def test_the_job_trains_each_agent_with_its_own_overrides(script, monkeypatch):
+    seen = {}
+
+    def fake_train(env, cfg, seed, checkpoint_every):
+        seen[cfg.entropy] = cfg.alpha
+        exc = FloatingPointError("stop once the configuration is built")
+        exc.decisions = 0
+        raise exc
+
+    import ocmdp.agents.oc_sac as oc_sac
+
+    threads = torch.get_num_threads()
+    monkeypatch.setattr(script, "_per_process", {})  # this test's tiny canary must not reach later tests
+    monkeypatch.setenv("OCMDP_CANARY", "tiny")
+    script.platform_fields()  # the canary trains with the real train
+    monkeypatch.setattr(oc_sac, "train", fake_train)
+    overrides = {"oc-sac": {"temperature": "fixed", "alpha": 0.3}, "sac": {"temperature": "fixed", "alpha": 0.03}}
+    try:
+        script.train_and_evaluate_pair((0.0, 0, 2_000, 1, overrides, 0, ((2, 2), None, None), False, None, "c-given", "f" * 64, False))
+    finally:
+        torch.set_num_threads(threads)
+    assert seen == {"pushforward": 0.3, "action": 0.03}
+
+
+def test_the_control_flag_compares_the_temperatures_the_agents_train_with(script):
+    # alpha 0 is the default, so an explicit alpha=0 on one agent changes nothing
+    assert script.entropy_objectives_coincide("c-given", (2, 2), {"oc-sac": {"alpha": 0.0}, "sac": {}})
+    assert not script.entropy_objectives_coincide("c-given", (2, 2), {"oc-sac": {"target_fraction": 0.77}, "sac": {}})
+
+
+@pytest.mark.parametrize("condition, sizes, alphas, coincide", [
+    ("c-given", (2, 2), (0.1, 0.1), True),
+    ("c-given", (3, 3, 3), (0.0, 0.0), True),
+    ("c-given", (2, 2), (0.3, 0.03), False),  # different temperatures: different objectives
+    ("c-given", (8, 5, 4, 2, 1), (0.1, 0.1), False),
+    ("no-c", (2, 2), (0.1, 0.1), False),
+])  # fmt: skip
+def test_equal_classes_with_c_given_and_equal_temperatures_are_flagged_as_a_control(script, condition, sizes, alphas, coincide):
+    overrides = {v: {"temperature": "fixed", "alpha": a} for v, a in zip(("oc-sac", "sac"), alphas)}
+    assert script.entropy_objectives_coincide(condition, sizes, overrides) is coincide
