+def entropy_objectives_coincide(condition: str, sizes, overrides: dict[str, dict]) -> bool:
+    """Whether OC-SAC's and SAC's objectives differ only by a constant on this instance and these settings.
+
+    With C given, tied drugs receive identical probabilities, so action entropy is pushforward
+    entropy plus sum_c q_c log n_c; with equal class sizes that is the constant log n. At equal
+    temperature settings the two agents then seek the same policy: their actor gradients agree
+    for a given critic, and their critic targets differ by alpha * gamma * log n per non-terminal
+    transition, which changes the optimiser's path but not its goal. A contrast there is a control:
+    a tie is expected, and identical training is guaranteed only at fixed temperature 0. The
+    temperature settings compared are the ones each agent trains with, defaults included.
+    """
+    from ocmdp.agents.oc_sac import SACConfig
+
+    defaults = asdict(SACConfig())
+
+    def temperature(v):
+        return {k: overrides[v].get(k, defaults[k]) for k in TEMPERATURE_FIELDS}
+
+    return condition == "c-given" and len(set(sizes)) == 1 and temperature("oc-sac") == temperature("sac")
+
